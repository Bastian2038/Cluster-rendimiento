{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipre.local/schemas/run-manifest.schema.json",
  "title": "Manifiesto compacto IPRE 2.0",
  "description": "El contexto 2.0 se valida mediante run-context.schema.json; load_run verifica identidad, integridad y restricciones entre ambos documentos.",
  "$defs": {
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "tokenizer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "tokenizer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "compact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "kind",
        "status",
        "started_at",
        "ended_at",
        "git",
        "hosts",
        "model",
        "errors",
        "context"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "description": "Tipo de pipeline; por ejemplo sesgo, rendimiento, sft, smoke o system-baseline."
        },
        "status": {
          "enum": [
            "running",
            "complete",
            "failed"
          ]
        },
        "started_at": {
          "$ref": "#/$defs/dateTime"
        },
        "ended_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/dateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit",
            "dirty"
          ],
          "properties": {
            "commit": {
              "$ref": "#/$defs/nullableString"
            },
            "dirty": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "model": {
          "oneOf": [
            {
              "$ref": "#/$defs/model"
            },
            {
              "type": "null"
            }
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "Error estructurado. Normalmente incluye un mensaje y puede agregar tipo, rutas u otros datos del productor.",
            "properties": {
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Hostnames observados; no deriva nodos remotos de la topología solicitada."
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "raw/context.json"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "system-baseline"
              }
            }
          },
          "then": {
            "properties": {
              "model": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "model": {
                "$ref": "#/$defs/model"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "running"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "ended_at": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "ended_at": {
                "$ref": "#/$defs/dateTime"
              }
            }
          }
        }
      ]
    }
  },
  "$ref": "#/$defs/compact"
}
