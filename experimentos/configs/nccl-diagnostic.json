{
  "schema_version": "1.0",
  "protocol_id": "nccl-diagnostic-v1",
  "session_limit_seconds": 1800,
  "invocation_limit_seconds": 45,
  "cleanup_grace_seconds": 5,
  "mpi_launcher": "mpirun",
  "binary_paths": {
    "pegasus": "/home/bastiangl/nccl-tests/build",
    "octopus": "/home/bastiangl/nccl-tests/build",
    "griffin": "/home/bastiangl/nccl-tests/build",
    "draggon": "/home/bastiangl/nccl-tests/build"
