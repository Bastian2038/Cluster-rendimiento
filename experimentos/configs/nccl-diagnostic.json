  "diagnostic": {"operation": "sendrecv", "pairs": "all-six", "minimum_bytes": 8, "maximum_bytes": 1048576, "factor": 2},
  "control": {"group": "single", "operation": "all_reduce", "minimum_bytes": 8, "maximum_bytes": 1048576, "factor": 2},
  "environment": {"NCCL_DEBUG": "INFO", "NCCL_DEBUG_SUBSYS": "INIT,BOOTSTRAP,NET,GRAPH"}
